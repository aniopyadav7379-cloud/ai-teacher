# ===== Core =====
APP_ENV=development

# Generate your own with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-64-char-string

# Local PostgreSQL
DATABASE_URL=postgresql+psycopg2://ai_teacher:ai_teacher@localhost:5432/ai_teacher

# Frontend
CORS_ALLOWED_ORIGINS=

# Local storage
VECTOR_DB_PATH=./data/chroma
UPLOAD_DIR=./data/uploads
MEDIA_DIR=./data/media
MAX_UPLOAD_MB=50


# ===== LLM - LOCAL OLLAMA =====
LLM_PROVIDER=ollama

# Local Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Local model
OLLAMA_MODEL=llama3.2

# No cloud API key required
OLLAMA_API_KEY=


# ===== EMBEDDINGS - LOCAL =====
EMBEDDING_PROVIDER=local

# Runs on your computer
EMBEDDING_MODEL=all-MiniLM-L6-v2

OPENAI_API_KEY=


# ===== TTS - LOCAL =====
TTS_PROVIDER=local_realtimevoicechat

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_HI=


# ===== AVATAR - LOCAL =====
AVATAR_PROVIDER=local_linlytalker

DID_API_KEY=
DID_PRESENTER_IMAGE_URL=


# ===== Auth =====
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ===== Job Queue =====
JOB_QUEUE_BACKEND=inprocess
REDIS_URL=redis://localhost:6379/0


# ===== Local Media Sidecars =====
LOCAL_TTS_ENDPOINT=http://localhost:8001
LOCAL_AVATAR_ENDPOINT=http://localhost:8002