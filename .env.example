# ===== Core =====
APP_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string
DATABASE_URL=postgresql+psycopg2://ai_teacher:ai_teacher@localhost:5432/ai_teacher
# Use sqlite for zero-setup local dev instead:
# DATABASE_URL=sqlite:///./ai_teacher.db

# Comma-separated frontend origins allowed to call this API. Ignored (wide
# open) when APP_ENV=development. REQUIRED in any other APP_ENV if your
# frontend is not served behind the same reverse proxy as the backend —
# e.g.: CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=

VECTOR_DB_PATH=./data/chroma
UPLOAD_DIR=./data/uploads
MEDIA_DIR=./data/media
MAX_UPLOAD_MB=50

# ===== LLM Provider (default: anthropic) =====
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ===== Embeddings Provider =====
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ===== TTS Provider (default: elevenlabs) =====
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_EN=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID_HI=

# ===== Avatar / Video Provider (default: did) =====
AVATAR_PROVIDER=did
DID_API_KEY=
DID_PRESENTER_IMAGE_URL=

# ===== Optional self-hosted media (GPU deployments only, see docs/self_hosted_media.md) =====
# TTS_PROVIDER=local_realtimevoicechat
# AVATAR_PROVIDER=local_linlytalker

# ===== Auth =====
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== Job queue =====
# inprocess = FastAPI BackgroundTasks (default, zero extra infrastructure, fine for local dev / single node)
# rq        = Redis-backed queue with a separate worker process (docker-compose sets this automatically)
JOB_QUEUE_BACKEND=inprocess
REDIS_URL=redis://localhost:6379/0

# ===== Self-hosted media sidecars (optional, GPU deployments only) =====
# Only read if TTS_PROVIDER=local_realtimevoicechat / AVATAR_PROVIDER=local_linlytalker.
# See docs/self_hosted_media.md. In Docker, point these at the sidecar's
# service name instead of localhost (e.g. http://realtimevoicechat:8001).
LOCAL_TTS_ENDPOINT=http://localhost:8001
LOCAL_AVATAR_ENDPOINT=http://localhost:8002
