# Optional. Leave unset for the default (relative /api, proxied to the
# backend by Vite in dev and by nginx in the Docker deployment — see
# vite.config.js / nginx.conf). Only set this if the frontend is deployed on
# a different origin than the backend.
# VITE_API_BASE_URL=https://api.example.com/api

# Optional. Where the Vite dev server proxies /api and /media to. Defaults
# to http://localhost:8000 (vite.config.js) if unset.
# VITE_DEV_API_PROXY_TARGET=http://localhost:8000
